XAI_API_KEY=your_api_key_here
XAI_MODEL=grok-4

# LangSmith tracing + LangGraph Studio
# Get an API key from https://smith.langchain.com -> Settings -> API Keys
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=agentic-ecommerce-langgraph
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Summarize message history to save on token usage
SUMMARIZE_AFTER_MESSAGES=12
SUMMARY_KEEP_MESSAGES=4

# For LangSmith studio  testing of new sessions as multiple threads are sticky by design
DEFAULT_USER_ID=anonymous
